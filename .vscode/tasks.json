{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend Server",
            "type": "shell",
            "command": "node server.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "PERIMETER Frontend Server is running",
                    "endsPattern": "PERIMETER Frontend Server is running"
                }
            }
        },
        {
            "label": "Start Python Server",
            "type": "shell",
            "command": "python serve.py",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "PERIMETER Frontend Server",
                    "endsPattern": "PERIMETER Frontend Server"
                }
            }
        }
    ]
}
